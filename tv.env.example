# Copy to .local/tv.env and fill in. .local/ is git-ignored.

# Your TV's IP address (TV: Settings > General > Network > Network Status > IP Settings).
TV_IP=192.168.1.50

# Name of the Samsung certificate profile you created in Tizen Studio's
# Certificate Manager (it must include your TV's DUID).
CERT_PROFILE=MySamsungTV

# 10-character package ID and app ID. Make up your own once and never change
# them, or the TV will see a rebuild as a different app.
# Package: exactly 10 letters/digits. App ID: <package>.<Name>
TIZEN_PACKAGE_ID=NIftyHome0
TIZEN_APP_ID=NIftyHome0.NIfty

# Where Tizen Studio is installed (folder that contains tools/ide/bin/tizen).
TIZEN_STUDIO=$HOME/tizen-studio
